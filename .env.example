# =============================================================================
# Pilketos E-Voting System — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
#
# Reference: 02_SYSTEM_ARCHITECTURE.md §Environment Variables (Required)
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Prisma connection string — via Supabase connection pooler or local PostgreSQL
# Default local port set to 5434 to prevent port collision with host services
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
DATABASE_URL=postgresql://postgres:password@localhost:5434/pilketos

# Direct connection string — bypasses pooler, required for prisma migrate
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL=postgresql://postgres:password@localhost:5434/pilketos

# Optional dedicated shadow database for Prisma migrate dev.
# Leave empty for local development unless Prisma asks for a shadow database.
SHADOW_DATABASE_URL=

# Optional Docker Compose host port/database overrides.
# If APP_PORT is changed, also update NEXTAUTH_URL and NEXT_PUBLIC_APP_URL.
APP_PORT=6500
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=pilketos
APP_UID=1000
APP_GID=1000

# ---------------------------------------------------------------------------
# AUTH (NextAuth / Auth.js v5)
# ---------------------------------------------------------------------------
# Random secret used to sign JWT session tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Base URL of the application (no trailing slash)
# Development default set to port 6500 to avoid port 3000 collisions
NEXTAUTH_URL=http://localhost:6500

# ---------------------------------------------------------------------------
# VOTING TOKEN SECURITY
# ---------------------------------------------------------------------------
# HMAC-SHA256 secret for deterministic token hashing.
# Must be at least 32 bytes (256-bit) of random data.
# Generate with: openssl rand -hex 32
# CRITICAL: Changing this value will invalidate ALL existing tokens.
TOKEN_HMAC_SECRET=

# ---------------------------------------------------------------------------
# SUPABASE
# ---------------------------------------------------------------------------
# Project URL — found in Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Anonymous key — safe to expose to the browser
# Found in Supabase Dashboard > Project Settings > API > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NEVER expose to the browser
# Found in Supabase Dashboard > Project Settings > API > service_role
# This key bypasses Row Level Security — handle with extreme care
SUPABASE_SERVICE_ROLE_KEY=

# Storage backend for candidate photos.
# local: stores files under public/uploads (recommended for local development)
# supabase: uses Supabase Storage bucket candidate-photos (recommended for production)
STORAGE_DRIVER=local

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
# Public base URL of the deployed application (no trailing slash)
# Used by Next.js and for generating absolute URLs
NEXT_PUBLIC_APP_URL=http://localhost:6500

# Application version — typically set from package.json during CI/CD
# Used by the /api/health endpoint
APP_VERSION=0.1.0

# Node environment — set automatically by Next.js (do not override manually)
# Values: development | production | test
# NODE_ENV=development
