# Source control
.git/
.gitignore

# Development artifacts
.next/
node_modules/
coverage/
.nyc_output/
_reference/

# Environment files — never include secrets in Docker image
.env
.env.local
.env.*.local
client_secret_*.json
credentials*.json
google-oauth-token*.json
gmail-token*.json

# Runtime uploads are mounted/persisted outside the image
public/uploads/**
!public/uploads/.gitkeep

# Documentation (not needed at runtime)
docs/
*.md
!README.md

# Development configuration files
.eslintrc*
eslint.config.*
.prettierrc*
.prettierignore
.husky/
tsconfig.tsbuildinfo

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
__tests__/
tests/

# OS artifacts
.DS_Store
Thumbs.db

# IDE artifacts
.vscode/
.idea/
*.swp
*.swo

# Log files
*.log
npm-debug.log*
